# Sovereign local environment configuration
# Copy to `.env` for local overrides. Do NOT commit secrets to version control.

# ---------------------------------------------------------------------------
# Core runtime & local server
# ---------------------------------------------------------------------------
# Dedicated Sovereign state directory (keeps Sovereign data isolated from any
# existing local coding-agent install). Falls back to T3CODE_HOME when unset.
# SOVEREIGN_HOME=~/.sovereign
# T3CODE_PORT=3773
# T3CODE_HOST=127.0.0.1
# T3CODE_DEV_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Optional AI provider API keys & CLI binary overrides
# ---------------------------------------------------------------------------
# Leave unset to use existing local CLI subscriptions (Codex, Claude Code, etc.).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# T3_CODEX_BIN=
# T3_CLAUDE_BIN=

# ---------------------------------------------------------------------------
# Optional Sovereign venture integrations (configure in-app or via env)
# ---------------------------------------------------------------------------
# Payments & billing
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PADDLE_API_KEY=
# LEMONSQUEEZY_API_KEY=

# Email & communications
# RESEND_API_KEY=
# SMTP_URL=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Voice & telephony agents
# VAPI_API_KEY=
# RETELL_API_KEY=
# ELEVENLABS_API_KEY=

# Hosting, DNS & source control
# GITHUB_TOKEN=
# VERCEL_TOKEN=
# CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# Optional self-hosted remote relay & cloud auth (disabled by default)
# ---------------------------------------------------------------------------
# Configure these only if you operate your own Clerk instance and relay server.
# T3CODE_CLERK_PUBLISHABLE_KEY=
# T3CODE_CLERK_JWT_TEMPLATE=
# T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=
# T3CODE_RELAY_URL=
# T3CODE_HOSTED_APP_URL=

# Optional signed macOS passkey builds (your own Apple Developer team)
# T3CODE_APPLE_TEAM_ID=
# T3CODE_MACOS_PROVISIONING_PROFILE=
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=

# Optional mobile OpenTelemetry export
# T3CODE_MOBILE_OTLP_TRACES_URL=
# T3CODE_MOBILE_OTLP_TRACES_DATASET=
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=
