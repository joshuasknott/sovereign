---
import LegalPage from "../components/LegalPage.astro";

const sections = [
  ["license", "MIT License"],
  ["attribution", "Upstream attribution"],
  ["providers", "Your content and providers"],
  ["warranty", "Disclaimer of warranty"],
] as const;
---

<LegalPage
  title="Terms of Service | Sovereign"
  description="MIT open-source licensing, upstream attribution, and usage terms for Sovereign."
  heading="Sovereign Terms & Licensing"
  lede="Sovereign is distributed as free, open-source software under the MIT License. You bring your own environments, credentials, and coding-agent providers."
  effectiveDate="2026-11-25"
  lastUpdated="2026-11-25"
  sections={sections}
>
  <section id="license">
    <p class="section-number">01</p>
    <h2>MIT License</h2>
    <p>
      Your use, copying, modification, and distribution of Sovereign source code are governed by
      the MIT License included in the repository. If you host Sovereign for others, you are
      responsible for any hosted terms you provide to your users.
    </p>
  </section>

  <section id="attribution">
    <p class="section-number">02</p>
    <h2>Upstream Attribution</h2>
    <p>
      Sovereign is an independent open-source project built upon T3 Code under the MIT License
      (Copyright (c) 2026 T3 Tools Inc.) and is not affiliated with, endorsed by, or maintained by
      T3 Tools, Inc. Trademarks of third parties remain the property of their respective owners.
    </p>
  </section>

  <section id="providers">
    <p class="section-number">03</p>
    <h2>Your Content and Providers</h2>
    <p>
      You retain all rights to your prompts, source code, diffs, and attachments. You are
      responsible for configuring and complying with the terms of any coding-agent harnesses, AI
      model providers, or source-control services you connect to Sovereign.
    </p>
  </section>

  <section id="warranty">
    <p class="section-number">04</p>
    <h2>Disclaimer of Warranty</h2>
    <p>
      Sovereign is provided "as is", without warranty of any kind, express or implied, as set forth
      in the MIT License. Review generated changes, commands, and diffs before applying or shipping
      them.
    </p>
  </section>
</LegalPage>
