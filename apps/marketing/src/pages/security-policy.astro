---
import LegalPage from "../components/LegalPage.astro";
import { GITHUB_REPOSITORY_URL } from "../lib/site";

const sections = [
  ["overview", "Overview"],
  ["reporting", "Reporting security issues"],
  ["practices", "Security design"],
  ["responsibilities", "Operator responsibilities"],
] as const;
---

<LegalPage
  title="Security Policy | Sovereign"
  description="How to report security issues in Sovereign and secure self-hosted environments."
  heading="Sovereign Security Policy"
  lede="Security is a shared responsibility. This policy outlines how to report vulnerabilities in Sovereign and how to secure the environments and providers you connect."
  effectiveDate="2026-11-25"
  lastUpdated="2026-11-25"
  sections={sections}
>
  <section id="overview">
    <p class="section-number">01</p>
    <h2>Overview</h2>
    <p>
      Sovereign connects desktop, web, and mobile clients to coding-agent environments you control.
      Sovereign is an independent open-source project built upon T3 Code (MIT License) and is not
      affiliated with T3 Tools, Inc.
    </p>
  </section>

  <section id="reporting">
    <p class="section-number">02</p>
    <h2>Reporting Security Issues</h2>
    <p>
      If you discover a security vulnerability in Sovereign, please report it privately through{" "}
      <a href={`${GITHUB_REPOSITORY_URL}/security/advisories`} target="_blank" rel="noopener noreferrer">
        GitHub Security Advisories
      </a>{" "}
      with reproduction steps, affected versions, and impact details. Please avoid public
      disclosure until maintainers have had a reasonable opportunity to investigate and remediate
      the issue.
    </p>
  </section>

  <section id="practices">
    <p class="section-number">03</p>
    <h2>Security Design</h2>
    <ul>
      <li>
        <strong>Local execution.</strong> Coding-session content stays between your clients, your
        environments, and the providers you configure.
      </li>
      <li>
        <strong>Scoped authentication.</strong> Remote connections use pairing credentials and
        scoped access tokens rather than open unauthenticated sockets.
      </li>
      <li>
        <strong>Protected credential storage.</strong> Supported platforms store tokens using
        OS-provided secure storage.
      </li>
    </ul>
  </section>

  <section id="responsibilities">
    <p class="section-number">04</p>
    <h2>Operator Responsibilities</h2>
    <ul>
      <li>Keep Sovereign, your operating system, and coding-agent CLIs up to date;</li>
      <li>Protect environment pairing tokens, API keys, and SSH/tunnel endpoints;</li>
      <li>Review tool approvals and diffs before running commands on sensitive repositories.</li>
    </ul>
  </section>
</LegalPage>
